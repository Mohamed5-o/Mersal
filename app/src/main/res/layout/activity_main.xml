<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/bg_pill"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/lang_toggle"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="@null"
            android:padding="14dp"
            android:src="@drawable/ic_logo_plane" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:text="@string/tagline"
            android:textColor="@color/sub"
            android:textSize="14sp" />

        <!-- status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:id="@+id/dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_off" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="@string/status_off"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/enable"
                android:textColor="@color/accent2"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/status_help"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <!-- form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Mersal.Label"
                android:layout_marginTop="0dp"
                android:text="@string/label_phone" />

            <EditText
                android:id="@+id/etPhone"
                style="@style/Mersal.Input"
                android:hint="@string/hint_phone"
                android:importantForAutofill="no"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <TextView
                android:id="@+id/btnPick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/btn_pick"
                android:textColor="@color/accent2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPicked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                style="@style/Mersal.Label"
                android:text="@string/label_message" />

            <EditText
                android:id="@+id/etMessage"
                style="@style/Mersal.Input"
                android:gravity="top|start"
                android:hint="@string/hint_message"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Mersal.Label"
                        android:text="@string/label_count" />

                    <EditText
                        android:id="@+id/etCount"
                        style="@style/Mersal.Input"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Mersal.Label"
                        android:text="@string/label_interval" />

                    <EditText
                        android:id="@+id/etInterval"
                        style="@style/Mersal.Input"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/limits_note"
                android:textColor="@color/sub"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="2"
                android:background="@drawable/bg_btn_start"
                android:stateListAnimator="@null"
                android:text="@string/start"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_stop"
                android:stateListAnimator="@null"
                android:text="@string/stop"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnQuick"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:stateListAnimator="@null"
            android:text="@string/quick"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="18dp"
            android:max="1"
            android:progress="0"
            android:progressBackgroundTint="#26FFFFFF"
            android:progressTint="@color/accent2" />

        <TextView
            android:id="@+id/txtState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/state_idle"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/footer"
            android:textColor="@color/sub_dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
