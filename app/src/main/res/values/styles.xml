<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mersal" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="colorAccent">@color/accent2</item>
        <item name="colorControlActivated">@color/accent2</item>
        <item name="colorControlNormal">@color/sub</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="Mersal.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Mersal.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/sub_dim</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
